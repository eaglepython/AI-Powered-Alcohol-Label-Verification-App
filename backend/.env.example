# TTB Label Verification Backend Configuration
# Copy this file to .env and fill in your actual values

# ── LLM Provider Setup (choose one) ──────────────────

# Option A: Anthropic Claude (Primary)
# Get free API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option B: Azure OpenAI (Fallback for firewall-restricted networks)
# Use this if your network blocks api.anthropic.com
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=your-azure-api-key-here

# ── Deployment Settings ────────────────────────────

# For Railway/Render: $PORT is automatically set
# For local Docker: PORT defaults to 8000
# PORT=8000

# ── Development/Debugging ──────────────────────────

# Enable debug logging (optional)
# DEBUG=true

# ── Notes ──────────────────────────────────────────

# For TTB Federal Deployment:
# 1. If Anthropic is blocked by firewall: Use Azure OpenAI credentials
# 2. If both are blocked: Contact IT to whitelist endpoints or deploy on internal network
# 3. For FedRAMP: Recommend using Azure OpenAI (already FedRAMP authorized)
