# ── AI PROVIDERS ──────────────────────────────────────────────
# Primary: Anthropic Claude Vision
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Fallback: Azure OpenAI (for firewall-restricted networks)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-azure-key-here

# ── SECURITY ───────────────────────────────────────────────────
# API key required on all /verify requests (X-API-Key header).
# Leave blank to disable auth (local dev only).
API_KEY=change-me-to-a-strong-random-secret

# Comma-separated list of allowed frontend origins for CORS.
# In production, set this to your actual frontend domain.
ALLOWED_ORIGINS=http://localhost:5173

# ── FRONTEND ───────────────────────────────────────────────────
# Backend URL as seen from the browser (used at Docker build time).
VITE_API_URL=http://localhost:8000
